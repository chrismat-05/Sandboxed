# Sandboxed Environment Configuration Example

# API Server Configuration
SANDBOXED_API_HOST=127.0.0.1
SANDBOXED_API_PORT=8000
SANDBOXED_ENV=development
SANDBOXED_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Persistence
DATABASE_URL=sqlite:///./sandboxed.db

# Execution Engine Configuration
SANDBOXED_MAX_CONCURRENCY=1
SANDBOXED_JOB_QUEUE_CAPACITY=50
SANDBOXED_STORAGE_DIR=/tmp/sandboxed_storage
SANDBOXED_DEFAULT_WALL_TIME_LIMIT_SEC=5.0
SANDBOXED_MAX_WALL_TIME_LIMIT_SEC=60.0
SANDBOXED_DEFAULT_MEMORY_LIMIT_MB=128
SANDBOXED_MAX_MEMORY_LIMIT_MB=1024
SANDBOXED_MAX_OUTPUT_BYTES=65536

# Linux Sandbox Runtime Paths (Ubuntu)
BWRAP_BINARY_PATH=/usr/bin/bwrap
CGROUP_ROOT=/sys/fs/cgroup
CGROUP_SANDBOX_SLICE=sandboxed.slice
